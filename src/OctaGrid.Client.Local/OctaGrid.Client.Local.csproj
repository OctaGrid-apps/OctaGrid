<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Needed here, not just on Data.Abstractions: dotnet ef's design-time services must be
         referenced by whichever project is passed as the startup project. Client.Local has no
         Main, so OctaGridSqliteDesignTimeFactory stands in for a running host. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OctaGrid.Agent.Core\OctaGrid.Agent.Core.csproj" />
    <ProjectReference Include="..\OctaGrid.Client.Contracts\OctaGrid.Client.Contracts.csproj" />
    <ProjectReference Include="..\OctaGrid.Application\OctaGrid.Application.csproj" />
    <ProjectReference Include="..\Connectors\OctaGrid.Connectors.BambuLab\OctaGrid.Connectors.BambuLab.csproj" />
    <ProjectReference Include="..\Connectors\OctaGrid.Connectors.Moonraker\OctaGrid.Connectors.Moonraker.csproj" />
  </ItemGroup>

</Project>
