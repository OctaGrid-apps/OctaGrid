<Project Sdk="Microsoft.NET.Sdk">
  <!-- The OctaGrid connector SDK. Contracts only: no host or printer-specific dependencies.
       Versioned with the app (Nerdbank.GitVersioning); see docs/VERSIONING.md. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>OctaGrid.Extensions.Abstractions</PackageId>
    <Description>Contracts for building OctaGrid printer connectors and other extensions.</Description>
    <PackageTags>octagrid;3d-printing;extensions;connector</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="..\OctaGrid.Protocol\OctaGrid.Protocol.csproj" />
  </ItemGroup>
</Project>
