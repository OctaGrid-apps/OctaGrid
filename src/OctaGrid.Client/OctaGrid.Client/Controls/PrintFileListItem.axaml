<UserControl
    x:Class="OctaGrid.Client.Controls.PrintFileListItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OctaGrid.Client.Controls"
    xmlns:vm="using:OctaGrid.Client.ViewModels"
    x:DataType="vm:PrintMetadataListItem">
    <Grid
        Height="50"
        ColumnDefinitions="Auto,*"
        RowDefinitions="*,Auto">
        <controls:FileThumbnail
            Grid.RowSpan="2"
            Width="{Binding $self.Bounds.Height}"
            Margin="0,0,8,0"
            Data="{Binding ThumbnailData}" />
        <TextBlock
            Grid.Column="1"
            Classes="lead mono"
            Text="{Binding Metadata.FileName}"
            ToolTip.Tip="{Binding Metadata.FileName}" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="1"
            Classes="small secondary"
            Text="{Binding SummaryText}"
            TextTrimming="CharacterEllipsis"
            ToolTip.Tip="{Binding SummaryText}" />

    </Grid>
</UserControl>
