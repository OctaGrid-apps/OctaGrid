<UserControl
    x:Class="OctaGrid.Client.Controls.PrinterStateBadge"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OctaGrid.Client.Controls"
    xmlns:conv="using:OctaGrid.Client.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root">

    <controls:Badge
        Background="{Binding #root.State, Converter={x:Static conv:StateBrushConverter.Background}}"
        Foreground="{Binding #root.State, Converter={x:Static conv:StateBrushConverter.Foreground}}">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse
                Width="6"
                Height="6"
                VerticalAlignment="Center"
                Fill="{Binding #label.Foreground}" />
            <TextBlock x:Name="label" Text="{Binding #root.State}" />
        </StackPanel>
    </controls:Badge>
</UserControl>
