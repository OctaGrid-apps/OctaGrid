<UserControl
    x:Class="OctaGrid.Client.Dialogs.EditPrinterView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:OctaGrid.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:OctaGrid.Client.Services"
    xmlns:vm="using:OctaGrid.Client.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    services:DialogManager.Register="{Binding}"
    x:DataType="vm:EditPrinterViewModel"
    mc:Ignorable="d">
    <Grid
        Width="400"
        RowDefinitions="*,Auto"
        RowSpacing="{DynamicResource Gap.Form}">
        <StackPanel Classes="form">
            <StackPanel Classes="field">
                <Label Content="Printer Name" Target="printerName" />
                <TextBox x:Name="printerName" Text="{Binding Item.Name}" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="{DynamicResource Gap.IconLabel}">
                <Label
                    VerticalAlignment="Center"
                    Content="Connector:"
                    Target="connectionProtocol" />
                <ComboBox
                    x:Name="connectionProtocol"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    DisplayMemberBinding="{Binding DisplayName}"
                    ItemsSource="{Binding Connectors}"
                    SelectedValue="{Binding Item.ConnectorId}"
                    SelectedValueBinding="{Binding Id}" />
            </Grid>

            <TextBlock
                Classes="small secondary"
                IsVisible="{Binding !Item.Fields.Count}"
                Text="This connector is not available. Its saved settings are kept; turn it on under Settings &gt; Extensions to change them."
                TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding Item.Fields}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Classes="form" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingFieldViewModel">
                        <StackPanel Classes="field">
                            <TextBlock Classes="small" Text="{Binding Label}" />
                            <TextBox IsVisible="{Binding IsTextInput}" Text="{Binding Value}" />
                            <TextBox
                                IsVisible="{Binding IsSecretInput}"
                                PasswordChar="•"
                                PlaceholderText="{Binding SecretPlaceholder}"
                                Text="{Binding Value}" />
                            <ToggleSwitch
                                IsChecked="{Binding BoolValue}"
                                IsVisible="{Binding IsToggle}"
                                OffContent="No"
                                OnContent="Yes" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                IsVisible="{Binding IsChoice}"
                                ItemsSource="{Binding Choices}"
                                SelectedItem="{Binding Value}" />
                            <TextBlock
                                Classes="caption secondary"
                                IsVisible="{Binding HasHelp}"
                                Text="{Binding Help}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="caption"
                                Foreground="{DynamicResource SystemErrorTextColor}"
                                IsVisible="{Binding HasError}"
                                Text="{Binding Error}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ToggleSwitch
                IsChecked="{Binding Item.IsEnabled}"
                OffContent="Disabled"
                OnContent="Enabled" />

            <StackPanel Classes="field">
                <Button
                    HorizontalAlignment="Left"
                    Command="{Binding TestConnectionCommand}"
                    Content="Test connection" />
                <TextBlock
                    Classes="small"
                    Foreground="{Binding TestResultStateKey, Converter={x:Static conv:StateBrushConverter.Foreground}}"
                    IsVisible="{Binding HasTestResult}"
                    Text="{Binding TestResultMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Classes="inline">
            <Button Command="{Binding CancelCommand}" Content="Cancel" />
            <Button
                Classes="primary"
                Command="{Binding ConfirmCommand}"
                Content="OK"
                IsEnabled="{Binding !Item.HasErrors}" />
        </StackPanel>
    </Grid>
</UserControl>
