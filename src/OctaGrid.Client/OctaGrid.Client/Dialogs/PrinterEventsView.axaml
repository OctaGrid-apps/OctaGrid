<UserControl
    x:Class="OctaGrid.Client.Dialogs.PrinterEventsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OctaGrid.Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:OctaGrid.Client.Services"
    xmlns:vm="using:OctaGrid.Client.ViewModels"
    Width="480"
    d:DesignWidth="480"
    services:DialogManager.Register="{Binding}"
    x:DataType="vm:PrinterEventsViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto" RowSpacing="{DynamicResource Gap.Form}">
        <ScrollViewer MaxHeight="420">
            <controls:PrinterEventsPanel />
        </ScrollViewer>

        <Button
            Grid.Row="1"
            HorizontalAlignment="Right"
            Classes="primary"
            Command="{Binding CloseCommand}"
            Content="Close" />
    </Grid>
</UserControl>
