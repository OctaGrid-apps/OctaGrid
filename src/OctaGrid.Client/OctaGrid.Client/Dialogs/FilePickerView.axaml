<UserControl
    x:Class="OctaGrid.Client.Dialogs.FilePickerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OctaGrid.Client.Controls"
    xmlns:converters="using:Avalonia.Data.Converters"
    xmlns:services="using:OctaGrid.Client.Services"
    xmlns:vm="using:OctaGrid.Client.ViewModels"
    MinWidth="350"
    MinHeight="150"
    MaxWidth="650"
    services:DialogManager.Register="{Binding}"
    x:DataType="vm:FilePickerViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource Gap.CardContent}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Gap.CardContent}">
            <Button
                MinWidth="{DynamicResource Space10}"
                Classes="icon"
                Command="{Binding CancelCommand}">
                <PathIcon Data="{DynamicResource arrow-left-regular}" />
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Classes="title"
                Text="Files" />
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Classes="inline">
                <Button
                    MinWidth="{DynamicResource Space10}"
                    Classes="icon"
                    Command="{Binding ConfirmCommand}"
                    IsEnabled="{Binding SelectedItem, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                    <PathIcon Data="{DynamicResource print-regular}" />
                </Button>
                <Button
                    MinWidth="{DynamicResource Space10}"
                    Classes="icon"
                    Command="{Binding DeleteFileCommand}"
                    IsEnabled="{Binding SelectedItem, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                    <PathIcon Data="{DynamicResource delete-regular}" />
                </Button>
                <Button
                    MinWidth="{DynamicResource Space10}"
                    Classes="icon"
                    Click="UploadFileButton_Click">
                    <PathIcon Data="{DynamicResource upload-regular}" />
                </Button>
            </StackPanel>
        </Grid>
        <Border
            Grid.Row="1"
            Padding="0"
            BorderBrush="{DynamicResource SystemBaseMediumColor}"
            Classes="divided"
            IsVisible="{Binding !IsFilesLoading}" />
        <ProgressBar
            Grid.Row="2"
            IsIndeterminate="True"
            IsVisible="{Binding IsFilesLoading}" />

        <ListBox
            Grid.Row="3"
            ItemsSource="{Binding Files}"
            SelectedItem="{Binding SelectedItem}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PrintMetadataListItem">
                    <controls:PrintFileListItem />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
