<UserControl
    x:Class="OctaGrid.Client.Dialogs.ExtensionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OctaGrid.Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:OctaGrid.Client.Services"
    xmlns:vm="using:OctaGrid.Client.ViewModels"
    Width="560"
    d:DesignWidth="560"
    services:DialogManager.Register="{Binding}"
    x:DataType="vm:ExtensionsViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto" RowSpacing="{DynamicResource Gap.Form}">
        <ScrollViewer MaxHeight="420">
            <StackPanel Classes="form">
                <TextBlock
                    Classes="small secondary"
                    Text="Extensions add support for printers and other features. Turning one off stops the printers that use it."
                    TextWrapping="Wrap" />

                <TextBlock
                    Classes="body secondary"
                    IsVisible="{Binding IsEmpty}"
                    Text="No extensions installed." />

                <ItemsControl IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Classes="card-content" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExtensionItemViewModel">
                            <Border
                                Background="{DynamicResource SystemBaseLowColor}"
                                BorderBrush="{DynamicResource SystemBaseMediumColor}"
                                BorderThickness="1"
                                Classes="tile">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Gap.IconLabel}">
                                    <StackPanel Classes="gap-0_5">
                                        <StackPanel Classes="inline">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Classes="lead"
                                                Text="{Binding Name}" />
                                            <controls:Badge Content="{Binding StateText}" />
                                        </StackPanel>
                                        <TextBlock Classes="small secondary" Text="{Binding Details}" />
                                        <TextBlock Classes="caption secondary" Text="{Binding CapabilitiesText}" />
                                        <TextBlock
                                            Classes="small"
                                            IsVisible="{Binding HasUsage}"
                                            Text="{Binding UsageText}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Classes="small"
                                            IsVisible="{Binding HasStateMessage}"
                                            Text="{Binding StateMessage}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Classes="gap-0_5">
                                        <ToggleSwitch
                                            HorizontalAlignment="Right"
                                            IsChecked="{Binding IsEnabled}"
                                            IsEnabled="{Binding CanToggle}"
                                            IsVisible="{Binding CanToggle}"
                                            OffContent=""
                                            OnContent="" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            Classes="primary"
                                            Command="{Binding ReviewCommand}"
                                            Content="Review…"
                                            IsVisible="{Binding NeedsApproval}" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            Command="{Binding RemoveCommand}"
                                            Content="Remove"
                                            IsVisible="{Binding CanUninstall}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                    Background="{DynamicResource SystemBaseLowColor}"
                    BorderBrush="{DynamicResource SystemBaseMediumColor}"
                    BorderThickness="1"
                    Classes="tile">
                    <StackPanel Classes="card-content" IsEnabled="{Binding CanEdit}">
                        <StackPanel Classes="gap-0_5">
                            <TextBlock Classes="lead" Text="Developer mode" />
                            <TextBlock
                                Classes="small secondary"
                                Text="{Binding DeveloperStatus}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Classes="inline">
                            <Button Click="OnChooseDeveloperFolder" Content="Choose folder…" />
                            <Button
                                Command="{Binding ReloadDeveloperCommand}"
                                Content="Reload"
                                IsVisible="{Binding IsDeveloperMode}" />
                            <Button
                                Command="{Binding TurnOffDeveloperModeCommand}"
                                Content="Turn off"
                                IsVisible="{Binding IsDeveloperMode}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <StackPanel Classes="inline" IsEnabled="{Binding CanEdit}">
                <Button Click="OnInstallFromFile" Content="Install from file…" />
                <Button Click="OnInstallFromFolder" Content="Install from folder…" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Classes="primary"
                Command="{Binding CloseCommand}"
                Content="Close" />
        </Grid>
    </Grid>
</UserControl>
