<!--
    OctaGrid.Client — the one application theme, built on Fluent2.
    Written for a Mica backdrop: the window is transparent and surfaces are translucent overlays
    (#05FFFFFF - #24FFFFFF) so the OS surface shows through.
    When transparency effects are off or unavailable, SolidBackdrop.axaml is layered on top and
    swaps the window and surface brushes for opaque ones.
    Built-in controls keep Fluent2's own colours: there is no palette override, because Fluent2
    derives its control fills from the palette. Our views use the brushes below instead.
-->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!--  0. The window shows the OS Mica backdrop  -->
                    <SolidColorBrush x:Key="AppWindowBackground" Color="Transparent" />

                    <!--  1. Secondary foreground used by our views  -->
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#9E000000" />

                    <!--  2. NavigationRail Mica Surface Brushes  -->
                    <SolidColorBrush x:Key="NavigationRailPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationRailContentBackground" Color="#05000000" />
                    <SolidColorBrush x:Key="NavigationRailContentBorderBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="NavigationRailItemForeground" Color="#5C5C5C" />
                    <SolidColorBrush x:Key="NavigationRailItemPointerOverBackground" Color="#0A000000" />
                    <SolidColorBrush x:Key="NavigationRailItemPointerOverForeground" Color="#000000" />
                    <SolidColorBrush x:Key="NavigationRailItemSelectedBackground" Color="#12000000" />
                    <SolidColorBrush x:Key="NavigationRailAccentBrush" Color="{DynamicResource SystemAccentColor}" />

                    <!--  3. OverlayDialog Surface Brushes (opaque floating surface)  -->
                    <SolidColorBrush x:Key="OverlayDialogBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="OverlayDialogBorderBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="OverlayDialogScrimBrush" Color="#80000000" />

                    <!--  4. SettingsExpander Sub-Card Surface Brush  -->
                    <SolidColorBrush x:Key="SettingsExpanderItemBackground" Color="#80FFFFFF" />

                    <!--  5. Card surfaces, outlines and badges: translucent so the Mica backdrop shows through  -->
                    <SolidColorBrush x:Key="CardBackground" Color="White" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="TileBackground" Color="#10000000" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#10000000" />
                    <SolidColorBrush x:Key="BadgeBackground" Color="#36000000" />

                    <!--  6. Chips (ToggleButton.chip): a subtle fill when on, not Fluent2's solid accent  -->
                    <SolidColorBrush x:Key="ChipBackgroundPointerOver" Color="#0A000000" />
                    <SolidColorBrush x:Key="ChipBackgroundChecked" Color="#12000000" />
                    <SolidColorBrush x:Key="ChipBackgroundCheckedPointerOver" Color="#1A000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!--  0. The window shows the OS Mica backdrop  -->
                    <SolidColorBrush x:Key="AppWindowBackground" Color="Transparent" />

                    <!--  1. Secondary foreground used by our views  -->
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#78FFFFFF" />

                    <!--  2. NavigationRail Mica Surface Brushes  -->
                    <SolidColorBrush x:Key="NavigationRailPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationRailContentBackground" Color="#05FFFFFF" />
                    <SolidColorBrush x:Key="NavigationRailContentBorderBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="NavigationRailItemForeground" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="NavigationRailItemPointerOverBackground" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="NavigationRailItemPointerOverForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavigationRailItemSelectedBackground" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="NavigationRailAccentBrush" Color="{DynamicResource SystemAccentColor}" />

                    <!--  3. OverlayDialog Surface Brushes (opaque floating surface over Mica window)  -->
                    <SolidColorBrush x:Key="OverlayDialogBackground" Color="#FF2C2C2C" />
                    <SolidColorBrush x:Key="OverlayDialogBorderBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="OverlayDialogScrimBrush" Color="#80000000" />

                    <!--  4. SettingsExpander Sub-Card Surface Brush  -->
                    <SolidColorBrush x:Key="SettingsExpanderItemBackground" Color="#02FFFFFF" />

                    <!--  5. Card surfaces, outlines and badges: translucent so the Mica backdrop shows through  -->
                    <SolidColorBrush x:Key="CardBackground" Color="#05FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="TileBackground" Color="#10FFFFFF" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#10FFFFFF" />
                    <SolidColorBrush x:Key="BadgeBackground" Color="#36FFFFFF" />

                    <!--  6. Chips (ToggleButton.chip): a subtle fill when on, not Fluent2's solid accent  -->
                    <SolidColorBrush x:Key="ChipBackgroundPointerOver" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ChipBackgroundChecked" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ChipBackgroundCheckedPointerOver" Color="#29FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Fluent2Theme />

    <!--  Make Avalonia 12's drawn title bar transparent so Window Mica backdrop shows through  -->
    <Style Selector="WindowDrawnDecorations:has-titlebar /template/ Panel#PART_TitleBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--  Prevent ContentPage from drawing its own background over the content frame  -->
    <Style Selector="ContentPage">
        <Setter Property="Background" Value="Transparent" />
    </Style>

</Styles>
