<!--
    OctaGrid.Client — Solid theme (default on every platform and in the XAML designer).
    Opaque surfaces with a cool slate palette and an indigo accent; it needs no OS backdrop (Mica),
    so it looks the same on Windows, Linux, macOS and WebAssembly.
    MicaTheme.axaml is layered on top of it on Windows and overrides these resources.

    Layers (dark): window #0F1218 < content #12161E < card #1C212C < dialog #171B25. Borders #232937 / #2E3544.
    Layers (light): window #F4F6FA < content / card #FFFFFF. Borders #DDE2EA.
-->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!--  Window  -->
                    <SolidColorBrush x:Key="AppWindowBackground" Color="#F4F6FA" />

                    <!--  NavigationRail  -->
                    <SolidColorBrush x:Key="NavigationRailPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationRailContentBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavigationRailContentBorderBrush" Color="#DDE2EA" />
                    <SolidColorBrush x:Key="NavigationRailItemForeground" Color="#667085" />
                    <SolidColorBrush x:Key="NavigationRailItemPointerOverBackground" Color="#E9ECF3" />
                    <SolidColorBrush x:Key="NavigationRailItemPointerOverForeground" Color="#151A24" />
                    <SolidColorBrush x:Key="NavigationRailItemSelectedBackground" Color="#E1E6F0" />
                    <SolidColorBrush x:Key="NavigationRailAccentBrush" Color="#4A5BD9" />

                    <!--  Dialogs and settings  -->
                    <SolidColorBrush x:Key="OverlayDialogBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="OverlayDialogBorderBrush" Color="#DDE2EA" />
                    <SolidColorBrush x:Key="SettingsExpanderItemBackground" Color="#FAFBFD" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <!--  Window  -->
                    <SolidColorBrush x:Key="AppWindowBackground" Color="#0F1218" />

                    <!--  NavigationRail  -->
                    <SolidColorBrush x:Key="NavigationRailPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationRailContentBackground" Color="#12161E" />
                    <SolidColorBrush x:Key="NavigationRailContentBorderBrush" Color="#232937" />
                    <SolidColorBrush x:Key="NavigationRailItemForeground" Color="#98A2B3" />
                    <SolidColorBrush x:Key="NavigationRailItemPointerOverBackground" Color="#1A1F2A" />
                    <SolidColorBrush x:Key="NavigationRailItemPointerOverForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavigationRailItemSelectedBackground" Color="#222838" />
                    <SolidColorBrush x:Key="NavigationRailAccentBrush" Color="#8C9BFF" />

                    <!--  Dialogs and settings  -->
                    <SolidColorBrush x:Key="OverlayDialogBackground" Color="#171B25" />
                    <SolidColorBrush x:Key="OverlayDialogBorderBrush" Color="#2E3544" />
                    <SolidColorBrush x:Key="SettingsExpanderItemBackground" Color="#141822" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <FluentTheme>
        <FluentTheme.Palettes>
            <ColorPaletteResources
                x:Key="Light"
                Accent="#4A5BD9"
                AltHigh="#FFFFFF"
                BaseHigh="#151A24"
                BaseLow="#DDE2EA"
                BaseMedium="#667085"
                BaseMediumHigh="#3F4859"
                BaseMediumLow="#98A2B3"
                ChromeAltLow="#3F4859"
                ChromeDisabledHigh="#DDE2EA"
                ChromeDisabledLow="#98A2B3"
                ChromeHigh="#C4CBD8"
                ChromeLow="#F4F6FA"
                ChromeMedium="#E6EAF1"
                ChromeMediumLow="#EDF0F5"
                ListLow="#E6EAF1"
                ListMedium="#DDE2EA"
                RegionColor="#F4F6FA" />

            <ColorPaletteResources
                x:Key="Dark"
                Accent="#6C7AF5"
                AltHigh="#0F1218"
                BaseHigh="#E8EBF2"
                BaseLow="#2E3544"
                BaseMedium="#8B94A7"
                BaseMediumHigh="#B7BECD"
                BaseMediumLow="#5C6579"
                ChromeAltLow="#B7BECD"
                ChromeDisabledHigh="#2E3544"
                ChromeDisabledLow="#5C6579"
                ChromeHigh="#3A4254"
                ChromeLow="#161A23"
                ChromeMedium="#1C212C"
                ChromeMediumLow="#232937"
                ListLow="#1C212C"
                ListMedium="#262C3A"
                RegionColor="#0F1218" />
        </FluentTheme.Palettes>
    </FluentTheme>

    <!--  The window background shows through the drawn title bar  -->
    <Style Selector="WindowDrawnDecorations:has-titlebar /template/ Panel#PART_TitleBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--  Pages sit directly on the window background  -->
    <Style Selector="ContentPage">
        <Setter Property="Background" Value="Transparent" />
    </Style>

</Styles>
