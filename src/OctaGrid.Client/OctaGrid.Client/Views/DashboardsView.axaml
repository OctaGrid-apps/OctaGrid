<ContentPage
    x:Class="OctaGrid.Client.Views.DashboardsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OctaGrid.Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:OctaGrid.Client.Services"
    xmlns:vm="using:OctaGrid.Client.ViewModels"
    controls:NavigationRail.Icon="{StaticResource dashboard-regular}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    services:DialogManager.Register="{Binding}"
    x:DataType="vm:DashboardsViewModel"
    Background="Transparent"
    Header="Dashboard"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:DashboardsViewModel />
    </Design.DataContext>

    <Grid
        ColumnDefinitions="Auto,*"
        ColumnSpacing="{DynamicResource Gap.PageSection}"
        RowDefinitions="Auto,*"
        RowSpacing="{DynamicResource Gap.PageSection}">
        <ComboBox
            MinWidth="240"
            DisplayMemberBinding="{Binding Name}"
            ItemsSource="{Binding Dashboards}"
            PlaceholderText="Dashboard"
            SelectedItem="{Binding SelectedDashboard}" />
        <StackPanel
            Grid.Column="1"
            HorizontalAlignment="Right"
            Classes="inline">
            <Button
                Classes="icon"
                Command="{Binding RefreshPrintersCommand}"
                ToolTip.Tip="Refresh dashboard items">
                <PathIcon Margin="8,0" Data="{StaticResource sync-regular}" />
            </Button>
            <Button Classes="icon" Command="{Binding EditSelectedDashboardCommand}">
                <PathIcon
                    Margin="8,0"
                    Data="{StaticResource edit-regular}"
                    ToolTip.Tip="Edit current dashboard" />
            </Button>
            <Button Classes="primary" Command="{Binding CreateDashboardCommand}">
                <StackPanel Classes="inline">
                    <PathIcon Width="12" Data="{StaticResource add-regular}" />
                    <TextBlock VerticalAlignment="Center" Text="New Dashboard" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ItemsControl
            Grid.Row="1"
            Grid.ColumnSpan="2"
            ItemsSource="{Binding Printers}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel
                        ItemSpacing="{DynamicResource Gap.CardGrid}"
                        LineSpacing="{DynamicResource Gap.CardGrid}"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!--            <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PrinterDashboardCardViewModel">
            <controls:PrinterDashboardCard />
            </DataTemplate>
            </ItemsControl.ItemTemplate>-->
        </ItemsControl>
    </Grid>
</ContentPage>
