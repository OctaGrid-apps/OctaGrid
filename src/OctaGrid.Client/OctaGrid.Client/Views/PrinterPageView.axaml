<UserControl
    x:Class="OctaGrid.Client.Views.PrinterPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OctaGrid.Client.Controls"
    xmlns:conv="using:OctaGrid.Client.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designtime="using:OctaGrid.Client.DesignTime"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:OctaGrid.Client.Services"
    xmlns:vm="using:OctaGrid.Client.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="900"
    x:DataType="vm:PrinterPageViewModel"
    Background="Transparent"
    mc:Ignorable="d">
    <Design.DataContext>
        <x:Static Member="designtime:DesignData.PrinterPage" />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="PathIcon.startPause">
            <Setter Property="Data" Value="{StaticResource play-regular}" />
        </Style>
        <Style Selector="PathIcon.startPause.printing">
            <Setter Property="Data" Value="{StaticResource pause-regular}" />
        </Style>
        <Style Selector="PathIcon.startPause.paused">
            <Setter Property="Data" Value="{StaticResource pause-filled}" />
        </Style>

        <!--
            The page adapts to its own width (the container below), not to the window: it can sit next to a navigation
            rail or in a narrow window. Wide: the job and the temperatures side by side. Narrow: one below the other, with
            the temperature tiles in one column when even that is tight, and the extras of a file row dropped.
            The wide layout is a style as well (not an attribute) so that the narrow styles below can override it.
        -->
        <Style Selector="Border#JobCard">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
        </Style>
        <Style Selector="Border#TemperaturesCard">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
        </Style>
        <Style Selector="UniformGrid#TemperatureTiles">
            <Setter Property="Columns" Value="2" />
        </Style>

        <ContainerQuery Name="printerPage" Query="max-width:780">
            <Style Selector="Border#JobCard">
                <Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
            <Style Selector="Border#TemperaturesCard">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
                <Setter Property="Margin" Value="{DynamicResource Margin.CardStack}" />
            </Style>
        </ContainerQuery>

        <ContainerQuery Name="printerPage" Query="max-width:560">
            <Style Selector="StackPanel.file-estimate">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>

        <ContainerQuery Name="printerPage" Query="max-width:420">
            <Style Selector="UniformGrid#TemperatureTiles">
                <Setter Property="Columns" Value="1" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <ScrollViewer>
        <Border
            Classes="page"
            Container.Name="printerPage"
            Container.Sizing="Width">
            <StackPanel Spacing="{DynamicResource Gap.PageSection}">

                <!--  Header: back, name, state  -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Back"
                        Classes="icon"
                        Command="{Binding GoBackCommand}"
                        ToolTip.Tip="Back">
                        <PathIcon Data="{StaticResource arrow-left-regular}" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!--  The badge goes below a long name instead of being pushed out of the page  -->
                        <WrapPanel ItemSpacing="{DynamicResource Gap.IconLabel}" LineSpacing="{DynamicResource Gap.Hairline}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="title"
                                Text="{Binding Item.Name}"
                                TextWrapping="Wrap" />
                            <controls:PrinterStateBadge
                                VerticalAlignment="Center"
                                IsVisible="{Binding Item.IsConnectorAvailable}"
                                State="{Binding Item.State}" />
                            <controls:ConnectorUnavailableBadge VerticalAlignment="Center" IsVisible="{Binding !Item.IsConnectorAvailable}" />
                        </WrapPanel>
                        <TextBlock Classes="small secondary" Text="{Binding ConnectorName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="inline">
                        <Button
                            AutomationProperties.Name="Stop print"
                            Classes="icon"
                            Command="{Binding Card.StopButtonClickedCommand}"
                            IsEnabled="{Binding Item.CanStop}"
                            ToolTip.Tip="Stop print">
                            <PathIcon Data="{StaticResource stop-regular}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="{Binding Item.StartPauseLabel}"
                            Classes="icon"
                            Command="{Binding Card.StartPauseButtonClickedCommand}"
                            IsEnabled="{Binding Item.CanStartPause}"
                            ToolTip.Tip="{Binding Item.StartPauseLabel}">
                            <PathIcon
                                Classes="startPause"
                                Classes.paused="{Binding Item.IsPaused}"
                                Classes.printing="{Binding Item.IsPrinting}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Conditions  -->
                <Border
                    Padding="{DynamicResource Padding.Chip}"
                    Background="{Binding Item.State, Converter={x:Static conv:StateBrushConverter.Background}}"
                    BorderBrush="{Binding Item.State, Converter={x:Static conv:StateBrushConverter.Foreground}}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusSm}"
                    IsVisible="{Binding Item.ConditionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <ItemsControl ItemsSource="{Binding Item.ConditionMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    Foreground="{Binding $parent[ItemsControl].((vm:PrinterPageViewModel)DataContext).Item.State, Converter={x:Static conv:StateBrushConverter.Foreground}}"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <TabItem Header="Overview">
                        <StackPanel Spacing="{DynamicResource Gap.PageSection}">
                            <!--  Two rows so that the cards can sit side by side or one below the other; see the styles above  -->
                            <Grid
                                x:Name="OverviewGrid"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="{DynamicResource Gap.CardGrid}"
                                RowDefinitions="Auto,Auto">

                                <!--  Current job  -->
                                <Border
                                    x:Name="JobCard"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Classes="card">
                                    <StackPanel Classes="card-content">
                                        <TextBlock Classes="overline" Text="CURRENT JOB" />
                                        <Border
                                            Height="200"
                                            Background="{DynamicResource TileBackground}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            Classes="tile">
                                            <Grid>
                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Item.ThumbnailData, Converter={x:Static conv:CollectionIsNullOrEmptyConverter.Instance}}"
                                                    Spacing="{DynamicResource Gap.CardContent}">
                                                    <PathIcon
                                                        Width="32"
                                                        Height="32"
                                                        Data="{StaticResource cube-regular}" />
                                                    <TextBlock
                                                        Classes="overline"
                                                        Text="NO PREVIEW"
                                                        TextAlignment="Center" />
                                                </StackPanel>
                                                <Image
                                                    IsVisible="{Binding !Item.ThumbnailData, Converter={x:Static conv:CollectionIsNullOrEmptyConverter.Instance}}"
                                                    Source="{Binding Item.ThumbnailData, Converter={x:Static conv:ByteArrayToBitmapConverter.Instance}}"
                                                    Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                            Classes="caption mono"
                                            Text="{Binding Item.PrintFileName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Item.PrintFileName}" />
                                        <!--  Progress with its times, and the layers: the layers move to the next line when there is no room  -->
                                        <WrapPanel ItemSpacing="{DynamicResource Gap.CardGrid}" LineSpacing="{DynamicResource Gap.CardContent}">
                                            <StackPanel Classes="inline">
                                                <TextBlock Classes="display" Text="{Binding Item.Progress, StringFormat='{}{0:P0}'}" />
                                                <TextBlock VerticalAlignment="Bottom" Classes="small secondary">
                                                    <Run Text="{Binding Item.PrintTime, StringFormat='{}{0:HH:mm:ss}'}" />
                                                    <Run Text="/" />
                                                    <Run Text="{Binding Item.PrintTimeTotal, StringFormat='{}{0:HH:mm:ss}'}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center" Classes="inline">
                                                <PathIcon Data="{StaticResource layer-regular}" />
                                                <TextBlock VerticalAlignment="Center" Classes="caption secondary">
                                                    <Run Text="{Binding Item.CurrentLayer, TargetNullValue='---'}" />
                                                    <Run Text="/" />
                                                    <Run Text="{Binding Item.TotalLayerCount, TargetNullValue='---'}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </WrapPanel>
                                        <ProgressBar
                                            Height="4"
                                            Background="{Binding Item.State, Converter={x:Static conv:StateBrushConverter.Background}}"
                                            Foreground="{Binding Item.State, Converter={x:Static conv:StateBrushConverter.Foreground}}"
                                            Maximum="1"
                                            Minimum="0"
                                            ShowProgressText="False"
                                            Value="{Binding Item.Progress}" />
                                    </StackPanel>
                                </Border>

                                <!--  Temperatures  -->
                                <Border
                                    x:Name="TemperaturesCard"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Classes="card">
                                    <StackPanel Classes="card-content">
                                        <TextBlock Classes="overline" Text="TEMPERATURES" />
                                        <UniformGrid
                                            x:Name="TemperatureTiles"
                                            ColumnSpacing="{DynamicResource Gap.CardContent}"
                                            RowSpacing="{DynamicResource Gap.CardContent}">
                                            <Border Background="{DynamicResource TileBackground}" Classes="tile">
                                                <StackPanel Classes="gap-0_5">
                                                    <TextBlock
                                                        HorizontalAlignment="Left"
                                                        Classes="overline"
                                                        Text="HOTEND" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        Classes="metric"
                                                        Text="{Binding Item.NozzleTemperature, StringFormat='{}{0:F1}°'}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        Classes="small secondary"
                                                        Text="{Binding Item.NozzleTargetTemperature, StringFormat='{}{0:F1}°'}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource TileBackground}" Classes="tile">
                                                <StackPanel Classes="gap-0_5">
                                                    <TextBlock
                                                        HorizontalAlignment="Left"
                                                        Classes="overline"
                                                        Text="BED" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        Classes="metric"
                                                        Text="{Binding Item.BedTemperature, StringFormat='{}{0:F1}°'}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        Classes="small secondary"
                                                        Text="{Binding Item.BedTargetTemperature, StringFormat='{}{0:F1}°'}" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--  Temperature history  -->
                            <Border
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                Classes="card">
                                <StackPanel Classes="card-content">
                                    <!--  The legend follows the title and moves below it when there is no room  -->
                                    <WrapPanel ItemSpacing="{DynamicResource Gap.CardGrid}" LineSpacing="{DynamicResource Gap.CardContent}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Classes="overline"
                                            Text="TEMPERATURE HISTORY" />
                                        <StackPanel VerticalAlignment="Center" Classes="inline">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Fill="{DynamicResource Chart.Hotend}" />
                                            <TextBlock Classes="small secondary" Text="Hotend" />
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Fill="{DynamicResource Chart.Bed}" />
                                            <TextBlock Classes="small secondary" Text="Bed" />
                                            <TextBlock Classes="small secondary" Text="(dashed: target)" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <controls:TemperatureChart
                                        Height="240"
                                        AutomationProperties.Name="Temperature history of the hotend and bed over the last 10 minutes"
                                        BedBrush="{DynamicResource Chart.Bed}"
                                        GridBrush="{DynamicResource CardBorderBrush}"
                                        HotendBrush="{DynamicResource Chart.Hotend}"
                                        Source="{Binding Card.TemperatureHistory}"
                                        TextBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!--  Files on the printer  -->
                    <TabItem Header="Files">
                        <!--  The file list asks before it deletes, so it needs a place to show that question.  -->
                        <StackPanel services:DialogManager.Register="{Binding Files}" Spacing="{DynamicResource Gap.CardContent}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="overline"
                                    Text="FILES ON THE PRINTER" />
                                <StackPanel Grid.Column="1" Classes="inline">
                                    <Button
                                        AutomationProperties.Name="Upload a file"
                                        Classes="icon"
                                        Click="UploadFileButton_Click"
                                        ToolTip.Tip="Upload a file">
                                        <PathIcon Data="{StaticResource upload-regular}" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Refresh files"
                                        Classes="icon"
                                        Command="{Binding Files.LoadDataCommand}"
                                        ToolTip.Tip="Refresh files">
                                        <PathIcon Data="{StaticResource arrow-clockwise-regular}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Files.IsFilesLoading}" />
                            <StackPanel Classes="inline" IsVisible="{Binding Files.HasError}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="body"
                                    Text="{Binding Files.ErrorMessage}"
                                    TextWrapping="Wrap" />
                                <Button Command="{Binding Files.LoadDataCommand}" Content="Try again" />
                            </StackPanel>
                            <TextBlock
                                Classes="body secondary"
                                IsVisible="{Binding Files.IsEmpty}"
                                Text="There are no files on this printer." />
                            <ItemsControl ItemsSource="{Binding FileRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{DynamicResource Gap.CardContent}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PrinterFileRowViewModel">
                                        <controls:PrinterFileRow />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>

                    <!--  What happened to the printer  -->
                    <TabItem Header="Events">
                        <controls:PrinterEventsPanel DataContext="{Binding PrinterEvents}" />
                    </TabItem>

                    <!--  What the printer writes to its console; only for connectors that report one  -->
                    <TabItem Header="Console" IsVisible="{Binding HasConsole}">
                        <controls:PrinterConsolePanel DataContext="{Binding PrinterConsole}" />
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
