<ContentPage
    x:Class="OctaGrid.Client.Views.AgentListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:agents="using:OctaGrid.Protocol.Agents"
    xmlns:controls="using:OctaGrid.Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designtime="using:OctaGrid.Client.DesignTime"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:OctaGrid.Client.Services"
    xmlns:vm="using:OctaGrid.Client.ViewModels"
    controls:NavigationRail.Icon="{StaticResource agents-regular}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    services:DialogManager.Register="{Binding}"
    x:DataType="vm:AgentListViewModel"
    Background="Transparent"
    Header="Agents"
    mc:Ignorable="d">
    <Design.DataContext>
        <x:Static Member="designtime:DesignData.Agents" />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Gap.PageSection}">

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                Classes="title"
                Text="Agents" />
            <Button
                Grid.Column="1"
                Classes="primary"
                Command="{Binding CreateAgentCommand}">
                <StackPanel Classes="inline">
                    <PathIcon Width="12" Data="{StaticResource add-regular}" />
                    <TextBlock VerticalAlignment="Center" Text="New Agent" />
                </StackPanel>
            </Button>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Agents}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel
                        ItemSpacing="{DynamicResource Gap.CardGrid}"
                        LineSpacing="{DynamicResource Gap.CardGrid}"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.DataTemplates>
                <DataTemplate x:DataType="agents:AgentResponse">
                    <Border
                        Background="{DynamicResource SystemAltMediumLowColor}"
                        BorderBrush="{DynamicResource SystemBaseMediumColor}"
                        BorderThickness="1"
                        Classes="card"
                        CornerRadius="{DynamicResource RadiusXl}">
                        <StackPanel MinWidth="300" Classes="card-content">
                            <DockPanel>
                                <Button
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="More options"
                                    BorderBrush="Transparent"
                                    Classes="icon"
                                    DockPanel.Dock="Right">
                                    <PathIcon
                                        Width="12"
                                        Height="12"
                                        Data="{StaticResource more-vertical-regular}" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem
                                                Command="{Binding $parent[ContentPage].((vm:AgentListViewModel)DataContext).EditAgentCommand}"
                                                CommandParameter="{Binding}"
                                                Header="Edit">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource edit-regular}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem CommandParameter="{Binding}" Header="Delete">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="{StaticResource delete-regular}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock Classes="title" Text="{Binding Name}" />
                            </DockPanel>
                            <Border
                                Padding="0"
                                BorderBrush="{DynamicResource SystemBaseMediumColor}"
                                Classes="divided" />
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="{DynamicResource Gap.CardContent}"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="{DynamicResource Gap.KeyValue}">
                                <TextBlock Classes="small secondary" Text="Status" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Classes="small mono"
                                    Text="{Binding Status}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Classes="small secondary"
                                    Text="Key" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Classes="small"
                                    Text="{Binding Token, TargetNullValue='---'}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.DataTemplates>
        </ItemsControl>
    </Grid>
</ContentPage>
