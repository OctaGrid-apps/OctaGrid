<UserControl
    x:Class="OctaGrid.Client.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OctaGrid.Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:OctaGrid.Client.Services"
    xmlns:views="using:OctaGrid.Client.Views"
    xmlns:vm="using:OctaGrid.Client.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    services:DialogManager.Register="{Binding}"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <controls:NavigationRail HideHeaderWhenSelected="True">

        <controls:NavigationRailItem
            Header="Dashboard"
            Icon="{StaticResource dashboard-regular}"
            PageType="{x:Type views:DashboardsView}" />

        <controls:NavigationRailItem
            Header="Printers"
            Icon="{StaticResource print-regular}"
            PageType="{x:Type views:PrinterListView}" />

        <controls:NavigationRailItem
            Header="Agents"
            Icon="{StaticResource agents-regular}"
            IsVisible="{Binding IsRemoteMode}"
            PageType="{x:Type views:AgentListView}" />

        <controls:NavigationRailItem
            Header="Workspaces"
            Icon="{StaticResource grid-dots-regular}"
            IsVisible="{Binding IsRemoteMode}"
            PageType="{x:Type views:WorkspaceListView}" />

        <controls:NavigationRail.FooterItems>
            <controls:NavigationRailItem
                Header="Account"
                Icon="{StaticResource person-regular}"
                IsVisible="{Binding IsRemoteMode}">
                <TextBlock Text="Account view" />
            </controls:NavigationRailItem>

            <controls:NavigationRailItem
                Header="Settings"
                Icon="{StaticResource settings-regular}"
                PageType="{x:Type views:SettingsView}" />
        </controls:NavigationRail.FooterItems>

    </controls:NavigationRail>
</UserControl>
