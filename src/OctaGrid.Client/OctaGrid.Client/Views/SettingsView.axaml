<ContentPage
    x:Class="OctaGrid.Client.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OctaGrid.Client.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:OctaGrid.Client.Services"
    xmlns:vm="using:OctaGrid.Client.ViewModels"
    controls:NavigationRail.Icon="{StaticResource settings-regular}"
    d:DesignHeight="800"
    d:DesignWidth="1600"
    services:DialogManager.Register="{Binding}"
    x:DataType="vm:SettingsViewModel"
    Background="Transparent"
    Header="Settings"
    mc:Ignorable="d">

    <ContentPage.Styles>
        <Style Selector="controls|SettingsCard.highlight">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
    </ContentPage.Styles>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1024"
            HorizontalAlignment="Stretch"
            Classes="page-sections">

            <TextBlock Classes="title" Text="Settings" />

            <!--  Mode Section  -->
            <controls:SettingsGroup Header="Mode" IsVisible="False">
                <controls:SettingsExpander
                    Description="Define how application will work - locally or with a server"
                    Header="Application mode"
                    Icon="{StaticResource virtual-network-regular}"
                    IsExpanded="True"
                    IsRestartRequired="{Binding IsClientModeApplied}"
                    RestartCommand="{Binding RestartAppCommand}">
                    <controls:SettingsExpander.Content>
                        <ComboBox
                            DisplayMemberBinding="{Binding DisplayText}"
                            ItemsSource="{Binding AppClientModes}"
                            SelectedItem="{Binding SelectedAppClientMode}" />
                    </controls:SettingsExpander.Content>

                    <controls:SettingsCard
                        Description="Remote server address"
                        Header="Server host"
                        Icon="{StaticResource server-link-regular}"
                        IsVisible="{Binding IsRemoteMode}">
                        <TextBox MinWidth="240" PlaceholderText="https://server_address.com" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Ask on app startup" Icon="{StaticResource task-list-square-regular}">
                        <ToggleSwitch
                            IsChecked="{Binding AskClientModeOnAppStart}"
                            OffContent="Disabled"
                            OnContent="Enabled" />
                    </controls:SettingsCard>
                </controls:SettingsExpander>
            </controls:SettingsGroup>

            <!--  Appearance Section  -->
            <controls:SettingsGroup Header="Appearance">
                <controls:SettingsCard
                    Description="Application appearance"
                    Header="Theme"
                    Icon="{StaticResource paint-brush-regular}">
                    <ComboBox
                        DisplayMemberBinding="{Binding DisplayText}"
                        ItemsSource="{Binding AppElementThemes}"
                        SelectedItem="{Binding SelectedAppElementTheme}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Window transparency level"
                    Header="Transparency level"
                    Icon="{StaticResource square-hint-sparkles-regular}"
                    IsVisible="False">
                    <ComboBox
                        DisplayMemberBinding="{Binding DisplayText}"
                        ItemsSource="{Binding WindowTransparencyLevels}"
                        SelectedItem="{Binding SelectedWindowTransparencyLevel}" />
                </controls:SettingsCard>
            </controls:SettingsGroup>

            <!--  Language Section  -->
            <controls:SettingsGroup Header="Language" IsVisible="False">
                <controls:SettingsCard Header="App language" Icon="{StaticResource local-language-globe-regular}">
                    <ComboBox SelectedIndex="0">
                        <ComboBox.Items>
                            <ComboBoxItem Content="English" />
                        </ComboBox.Items>
                    </ComboBox>
                </controls:SettingsCard>
            </controls:SettingsGroup>

            <!--  Extensions Section  -->
            <controls:SettingsGroup Header="Extensions" IsVisible="{Binding CanManageExtensions}">
                <controls:SettingsCard
                    Description="{Binding ExtensionsSummary}"
                    Header="Installed extensions"
                    Icon="{StaticResource cube-regular}">
                    <Button Command="{Binding ManageExtensionsCommand}" Content="Manage extensions" />
                </controls:SettingsCard>
            </controls:SettingsGroup>

            <!--  Update Section  -->
            <controls:SettingsGroup Header="Updates">
                <controls:SettingsCard
                    Classes.highlight="{Binding HasAvailableUpdate}"
                    Description="{Binding UpdateStatusText}"
                    Icon="{StaticResource sync-regular}">
                    <controls:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Application updates" VerticalAlignment="Center" />
                            <Border
                                Background="{DynamicResource SystemAccentColor}"
                                CornerRadius="10"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasAvailableUpdate}">
                                <TextBlock
                                    Text="Update available"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White" />
                            </Border>
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <StackPanel
                        HorizontalAlignment="Right"
                        Spacing="6"
                        VerticalAlignment="Center">
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ProgressBar
                            Width="120"
                            Height="6"
                            VerticalAlignment="Center"
                            IsIndeterminate="{Binding IsCheckingForUpdates}"
                            IsVisible="{Binding IsUpdating}"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding UpdateProgress}" />
                        <Button
                            Command="{Binding ShowReleaseNotesCommand}"
                            Content="Release notes"
                            IsVisible="{Binding HasReleaseNotes}" />
                        <Button
                            Classes="primary"
                            Command="{Binding ApplyUpdateCommand}"
                            Content="{Binding UpdateActionText}"
                            IsVisible="{Binding HasAvailableUpdate}"
                            ToolTip.Tip="{Binding UpdateRestartNotice}" />
                        <Button
                            Command="{Binding CheckForUpdatesCommand}"
                            Content="Check for updates" />
                    </StackPanel>
                    <TextBlock
                        Classes="small secondary"
                        HorizontalAlignment="Right"
                        IsVisible="{Binding HasAvailableUpdate}"
                        MaxWidth="360"
                        Text="{Binding UpdateRestartNotice}"
                        TextAlignment="Right"
                        TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="{Binding UpdateChannelName}"
                    Header="Update channel"
                    Icon="{StaticResource arrow-clockwise-regular}" />
            </controls:SettingsGroup>

            <!--  About  -->
            <controls:SettingsGroup Header="About">
                <controls:SettingsExpander
                    Description="{Binding AppVersion}"
                    Header="OctaGrid"
                    Icon="{StaticResource virtual-network-regular}"
                    IsExpanded="False">
                    <controls:SettingsExpander.Content>
                        <TextBlock Text="More" />
                    </controls:SettingsExpander.Content>

                    <controls:SettingsCard>
                        <controls:SettingsCard.Header>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock Text="Version" />
                                    <TextBlock Text="GitHub" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <SelectableTextBlock Classes="secondary" Text="{Binding InfoVersion}" />
                                    <HyperlinkButton
                                        Padding="0"
                                        Content="https://github.com/OctaGrid-apps/OctaGrid"
                                        NavigateUri="https://github.com/OctaGrid-apps/OctaGrid" />
                                </StackPanel>
                            </Grid>
                        </controls:SettingsCard.Header>
                    </controls:SettingsCard>
                </controls:SettingsExpander>

                <controls:SettingsExpander
                    Description="Important safety warnings regarding high temperatures, moving mechanical parts, and remote 3D printer operation"
                    Header="Safety &amp; Disclaimer"
                    Icon="{StaticResource warning-regular}"
                    IsExpanded="False">
                    <controls:SettingsExpander.Content>
                        <Button Command="{Binding ShowSafetyDisclaimerCommand}" Content="View disclaimer" />
                    </controls:SettingsExpander.Content>

                    <controls:SettingsCard>
                        <controls:SettingsCard.Header>
                            <TextBlock
                                Classes="small secondary"
                                Text="3D printers contain high-temperature heating elements (nozzles and heated beds) and motorized moving axes that can cause severe burns, pinch injuries, or fire. Always verify that the printer's build area is clear of hands, tools, and obstructions before remotely starting or resuming a print job, and never leave operating 3D printers unattended without proper fire-safety and thermal runaway protections."
                                TextWrapping="Wrap" />
                        </controls:SettingsCard.Header>
                    </controls:SettingsCard>
                </controls:SettingsExpander>
            </controls:SettingsGroup>

            <!--  Diagnostics & feedback  -->
            <controls:SettingsGroup Header="Diagnostics &amp; feedback">
                <controls:SettingsCard
                    Description="Application logs"
                    Header="Logs"
                    Icon="{StaticResource folder-regular}">
                    <Button Command="{Binding OpenLogsFolderCommand}" Content="Open logs folder" />
                </controls:SettingsCard>
            </controls:SettingsGroup>
        </StackPanel>
    </ScrollViewer>
</ContentPage>
