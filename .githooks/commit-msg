#!/bin/sh

# Read the commit message from the file passed by git ($1)
commit_msg_file="$1"

# Strip BOM, carriage returns (\r), comments, and blank lines to get the subject line
first_line=$(sed -e 's/\r$//' -e 's/^\xEF\xBB\xBF//' "$commit_msg_file" | grep -v '^[[:space:]]*#' | grep -v '^[[:space:]]*$' | head -n 1)

# Allow merge commits and revert commits generated by git
if echo "$first_line" | grep -Eq '^(Merge |Revert )'; then
    exit 0
fi

# Regex for Conventional Commits:
# <type>(<scope>)?: <description> or <type>(<scope>)?!: <description>
# Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_\.\-]+\))?!?: .+$"

if ! echo "$first_line" | grep -Eq "$pattern"; then
    echo ""
    echo "================================================================================"
    echo "COMMIT REJECTED: Invalid commit message format."
    echo "================================================================================"
    echo ""
    echo "Your commit message:"
    echo "  $first_line"
    echo ""
    echo "OctaGrid enforces the Conventional Commits specification:"
    echo "  <type>(<scope>): <summary>"
    echo ""
    echo "Allowed types:"
    echo "  feat:      A new feature"
    echo "  fix:       A bug fix"
    echo "  refactor:  Code/UI changes that neither fix a bug nor add a feature"
    echo "  perf:      Performance improvements"
    echo "  style:     Formatting, missing semicolons, visual tweaks"
    echo "  test:      Adding or modifying tests"
    echo "  build:     Changes to build system, dependencies, or packaging (MSIX)"
    echo "  ci:        Changes to CI configuration or scripts"
    echo "  docs:      Documentation changes"
    echo "  chore:     Maintenance tasks"
    echo ""
    echo "Examples:"
    echo "  feat(dashboard): add live temperature graph"
    echo "  fix(agent): reconnect WebSocket on disconnect"
    echo "  refactor(client): simplify message handler"
    echo "  perf(ui): optimize printer card redraws"
    echo "  build(msix): update package manifest capabilities"
    echo ""
    echo "================================================================================"
    exit 1
fi
